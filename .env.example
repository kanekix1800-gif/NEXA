# ─────────────────────────────────────────────────────────────────────────────
# NEXA — variáveis de ambiente
# Copie este arquivo para ".env" e ajuste o que precisar.
# NENHUMA variável é obrigatória: sem configuração o app roda em MODO
# DEMONSTRAÇÃO (dados locais no navegador e NEXA IA simulada).
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (prefixo VITE_ = valores públicos, embutidos no bundle) ─────────
# Nunca coloque chaves privadas em variáveis VITE_.

# URL do serviço backend da NEXA IA (ver "npm run ai:server").
# Vazio = NEXA IA em modo demonstrativo (respostas determinísticas locais).
VITE_AI_API_URL=

# Centro do mapa (latitude/longitude) e nome exibido da cidade de demonstração.
# Todos os pontos demonstrativos são gerados em torno deste centro.
VITE_MAP_CENTER_LAT=-19.9320
VITE_MAP_CENTER_LNG=-43.9381
VITE_CITY_NAME=Cidade Modelo

# Latência simulada (ms) dos repositórios locais, para exibir estados de carregamento.
VITE_DEMO_LATENCY_MS=220

# Reservado para a futura camada Supabase (ainda não utilizada pelo app).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend da NEXA IA (somente servidor — NÃO usar prefixo VITE_) ───────────
# Provedor de IA. Valor suportado hoje: "anthropic".
AI_PROVIDER=anthropic
# Chave privada do provedor. Fica apenas no servidor.
ANTHROPIC_API_KEY=
# Modelo utilizado pelo provedor.
AI_MODEL=claude-opus-5-5
# Porta do serviço.
AI_PORT=8787
# Origens autorizadas (CORS), separadas por vírgula: esquema + domínio, sem caminho.
# Em produção, use o endereço do site — por exemplo: https://seu-usuario.github.io
AI_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Pedidos por minuto aceitos de um mesmo endereço (proteção simples contra abuso).
AI_RATE_LIMIT_PER_MINUTE=30
