{
  "name": "nexa",
  "private": true,
  "version": "0.1.0",
  "description": "NEXA — Conexões que transformam realidades. Plataforma comunitária que conecta moradores, comércio local, instituições e poder público.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ai:server": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tanstack/react-query": "^5.108.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
